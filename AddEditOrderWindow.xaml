<Window x:Class="ShoeStore_Oreshkov.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Oreshkov"
        mc:Ignorable="d"
        Title="Добавление/редактирование заказа" Height="450" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#7FFF00">
            <TextBlock Text="Управление заказом" FontSize="28"
                       FontFamily="Times New Roman" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <TextBlock Text="Артикул заказа" Grid.Row="1" Grid.Column="0"
                   FontSize="16" FontFamily="Times New Roman"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="0,0,10,0"/>
        <TextBox Name="OrderNumberTextbox" Grid.Row="1" Grid.Column="1"
                 Height="22" Width="215" HorizontalAlignment="Left"
                 Margin="10,0,0,0" IsReadOnly="True"
                 VerticalContentAlignment="Center"/>

        <TextBlock Text="Статус заказа" Grid.Row="2" Grid.Column="0"
                   FontSize="16" FontFamily="Times New Roman"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="0,0,10,0"/>
        <ComboBox Name="StatusCombobox" Grid.Row="2" Grid.Column="1"
                  Height="22" Width="215" HorizontalAlignment="Left"
                  Margin="10,0,0,0"
                  DisplayMemberPath="StatusName"
                  SelectedValuePath="ID_Order_Status"/>

        <TextBlock Text="Адрес пункта выдачи" Grid.Row="3" Grid.Column="0"
                   FontSize="16" FontFamily="Times New Roman"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="0,0,10,0" TextWrapping="Wrap"/>
        <ComboBox Name="PickupPointCombobox" Grid.Row="3" Grid.Column="1"
                  Height="22" Width="215" HorizontalAlignment="Left"
                  Margin="10,0,0,0"
                  DisplayMemberPath="FullAddress"
                  SelectedValuePath="ID_Point"/>

        <TextBlock Text="Дата заказа" Grid.Row="4" Grid.Column="0"
                   FontSize="16" FontFamily="Times New Roman"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="0,0,10,0"/>
        <DatePicker Name="OrderDatePicker" Grid.Row="4" Grid.Column="1"
                    Height="22" Width="215" HorizontalAlignment="Left"
                    Margin="10,0,0,0"/>

        <TextBlock Text="Дата выдачи" Grid.Row="5" Grid.Column="0"
                   FontSize="16" FontFamily="Times New Roman"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="0,0,10,0"/>
        <DatePicker Name="DeliveryDatePicker" Grid.Row="5" Grid.Column="1"
                    Height="22" Width="215" HorizontalAlignment="Left"
                    Margin="10,0,0,0"/>

        <Button Name="SaveButton" Content="Сохранить"
                Grid.Row="7" Grid.ColumnSpan="2"
                Width="150" Height="35"
                FontSize="16" FontFamily="Times New Roman"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Click="SaveButton_Click"/>
    </Grid>
</Window>
