<Window x:Class="ShoeStore_Oreshkov.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Oreshkov"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15"></RowDefinition>
            <RowDefinition Height="125"></RowDefinition>
            <RowDefinition Height="250"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal"  VerticalAlignment="Center" Background="#7FFF00">
            <Image Source="Icon.png" Height="120" Width="120" />
            <TextBlock VerticalAlignment="Center" Text="АВТОРИЗАЦИЯ" FontSize="45" Margin="20,0,0,0" FontFamily="Times New Roman" />
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Vertical" Margin="200,15,200,15">
            <TextBlock Text="Логин" FontFamily="Times New Roman"/>
            <TextBox x:Name="LoginTextBox" Text=""/>
            <TextBlock Text="Пароль" FontFamily="Times New Roman" Margin="0,15,0,0"/>
            <TextBox x:Name="PasswordTextBox" Text=""/>
            <Button x:Name="LoginButton" Content="Войти" FontFamily="Times New Roman" Margin="0,15,0,0" Click="LoginButton_Click"/>
            <Button x:Name="GuestLoginButton" Content="Войти как гость" FontFamily="Times New Roman" Margin="0,15,0,0" Click="GuestLoginButton_Click" />
        </StackPanel>
    </Grid>
</Window>
