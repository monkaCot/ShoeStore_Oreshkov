<Window x:Class="ShoeStore_Oreshkov.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Oreshkov"
        mc:Ignorable="d"
       Title="Заказы" Height="650" Width="900">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1" Grid.Column="1" Background="#7FFF00" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="Назад"
                        FontFamily="Times New Roman" FontSize="14"
                        VerticalAlignment="Center" Margin="5" Padding="10,5"
                        Click="BackButton_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Pictures/Icon.png" Height="50" Width="50" VerticalAlignment="Center" />
                    <TextBlock Text="Заказы" FontSize="32" FontWeight="Bold"
                               Margin="15,0,0,0" FontFamily="Times New Roman"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <ListView Name="OrdersList" Grid.Row="3" Grid.Column="1">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <EventSetter Event="MouseDoubleClick" Handler="OrderItem_MouseDoubleClick"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel Margin="5">
                                    <TextBlock>
                                        <Run Text="Артикул заказа: " FontWeight="Bold"/>
                                        <Run Text="{Binding ID_Order_Number, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Статус заказа: " FontWeight="Bold"/>
                                        <Run Text="{Binding Order_Status.StatusName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Адрес пункта выдачи: " FontWeight="Bold"/>
                                        <Run Text="{Binding Pickup_Points.FullAddress, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Дата заказа: " FontWeight="Bold"/>
                                        <Run Text="{Binding OrderDate, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy}}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Дата доставки" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}}"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="AddOrderButton" Content="Добавить заказ"
                    Width="150" Height="30" Margin="0,0,10,0"
                    FontFamily="Times New Roman" FontSize="14"
                    Click="AddOrderButton_Click" Visibility="Hidden"/>
            <Button x:Name="DeleteOrderButton" Content="Удалить заказ"
                    Width="150" Height="30"
                    FontFamily="Times New Roman" FontSize="14"
                    Click="DeleteOrderButton_Click" Visibility="Hidden"/>
        </StackPanel>
    </Grid>
</Window>